<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="product_template_form_paneer_batti" model="ir.ui.view">
        <field name="name">product.template.form.paneer.batti</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='sales']//group[1]" position="after">
                <!--
                    The group shows ONLY when internal reference = 'paneer_batti'.
                -->
                <group
                    string="Batti / Container Settings"
                    invisible="default_code != 'paneer_batti'">
                    <group>
                        <field
                            name="tare_weight_per_batti"
                            string="Tare Weight per Batti (kg)"
                            digits="[10,3]"/>
                    </group>
                    <group>
                        <div class="text-muted" colspan="2">
                            Enter the weight of a single batti (container) in kg.
                            This value will be auto-filled when Paneer Batti is
                            added to a Sale Order and can be overridden per order.
                        </div>
                    </group>
                </group>
            </xpath>

        </field>
    </record>
</odoo>
