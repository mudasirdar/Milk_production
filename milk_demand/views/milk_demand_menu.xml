              name="Milk Demand"
              sequence="25"
              web_icon="milk_demand,static/description/icon.png"/>

    <!-- Demands Menu -->
    <menuitem id="menu_milk_demand_demands"
              name="Demands"
              parent="menu_milk_demand_root"
              sequence="10"/>

    <menuitem id="menu_milk_demand_all"
              name="All Demands"
              parent="menu_milk_demand_demands"
