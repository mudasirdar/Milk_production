<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_milk_demand_form" model="ir.ui.view">
        <field name="name">milk.demand.form</field>
        <field name="model">milk.demand</field>
        <field name="arch" type="xml">
            <form string="Milk Demand">
                <header>
                    <button name="action_confirm" string="Confirm"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_convert_to_sale_order" string="Convert to Sales Order"
                            type="object" class="btn-success"
                            invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancel"
                            type="object" class="btn-secondary"
                            invisible="state in ('converted', 'cancelled')"/>
                    <button name="action_reset_draft" string="Reset to Draft"
                            type="object" class="btn-secondary"
                            invisible="state not in ('confirmed', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,converted"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sale_order" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="sale_order_count == 0">
                            <field name="sale_order_count" widget="statinfo" string="Sales Order"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Customer Information">
                            <field name="partner_id" readonly="state == 'converted'"/>
                            <field name="demand_date" readonly="state == 'converted'"/>
                            <field name="creation_date"/>
                        </group>
                        <group string="Summary">
                            <field name="total_qty"/>
                            <field name="total_amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="sale_order_id" readonly="1" invisible="not sale_order_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Demand Lines" name="lines">
                            <field name="line_ids" readonly="state == 'converted'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="crates" string="Crates" optional="show"/>
                                    <field name="quantity"/>
                                    <field name="uom_id" optional="show"/>
                                    <field name="price_unit" widget="monetary"/>
                                    <field name="subtotal" widget="monetary" sum="Total"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Add any notes about this demand..."
                                   readonly="state == 'converted'"/>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_milk_demand_list" model="ir.ui.view">
        <field name="name">milk.demand.list</field>
        <field name="model">milk.demand</field>
        <field name="arch" type="xml">
            <list string="Milk Demands"
                  decoration-success="state == 'converted'"
                  decoration-info="state == 'confirmed'"
                  decoration-muted="state == 'cancelled'">
                <header>
                    <button name="action_open_demand_report_wizard" string="Download Demand PDF"
                            type="object" class="btn-primary" icon="fa-file-pdf-o"/>
                </header>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="demand_date"/>
                <field name="creation_date" optional="hide"/>
                <field name="total_qty" sum="Total Qty"/>
                <field name="total_amount" sum="Total Amount" widget="monetary"/>
                <field name="sale_order_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'converted'"
                       decoration-info="state == 'confirmed'"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_milk_demand_search" model="ir.ui.view">
        <field name="name">milk.demand.search</field>
        <field name="model">milk.demand</field>
        <field name="arch" type="xml">
            <search string="Search Demands">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="demand_date"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Converted" name="converted" domain="[('state', '=', 'converted')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                <filter string="Demand Date" name="group_date" context="{'group_by': 'demand_date'}"/>
                <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- Calendar View -->
    <record id="view_milk_demand_calendar" model="ir.ui.view">
        <field name="name">milk.demand.calendar</field>
        <field name="model">milk.demand</field>
        <field name="arch" type="xml">
            <calendar string="Milk Demands" date_start="demand_date" color="partner_id" mode="month">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="total_qty"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Action -->
    <record id="action_milk_demand" model="ir.actions.act_window">
        <field name="name">Milk Demands</field>
        <field name="res_model">milk.demand</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new milk demand
            </p>
            <p>
                Record customer demands for milk products. Once confirmed,
                you can convert the demand into a Sales Order.
            </p>
        </field>
    </record>

    <!-- Action for Today's Demands -->
    <record id="action_milk_demand_today" model="ir.actions.act_window">
        <field name="name">Today's Demands</field>
        <field name="res_model">milk.demand</field>
        <field name="view_mode">list,form,calendar</field>
    </record>

    <!-- Action for Pending Conversion -->
    <record id="action_milk_demand_pending" model="ir.actions.act_window">
        <field name="name">Pending Conversion</field>
        <field name="res_model">milk.demand</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'confirmed')]</field>
    </record>

</odoo>
