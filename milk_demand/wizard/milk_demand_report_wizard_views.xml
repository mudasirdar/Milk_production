<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_milk_demand_report_wizard_form" model="ir.ui.view">
        <field name="name">milk.demand.report.wizard.form</field>
        <field name="model">milk.demand.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Download Demand PDF">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_report" string="Download PDF" type="object" class="btn-primary" icon="fa-download"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_milk_demand_report_wizard" model="ir.actions.act_window">
        <field name="name">Download Demand PDF</field>
        <field name="res_model">milk.demand.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
