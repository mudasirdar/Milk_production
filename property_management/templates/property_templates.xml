<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Property Listing Page -->
    <template id="property_listing_page" name="Property Listing">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container mt-4">
                    <!-- Page Header -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <h1 class="mb-3">Properties for Sale &amp; Rent</h1>
                            <p class="text-muted">Browse our collection of properties</p>
                        </div>
                    </div>

                    <!-- Search and Filters -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <form method="get" action="/properties" class="form-inline">
                                <div class="row w-100 g-3">
                                    <!-- Search -->
                                    <div class="col-md-4">
                                        <input type="text" name="search" class="form-control w-100"
                                               placeholder="Search properties..."
                                               t-att-value="search"/>
                                    </div>

                                    <!-- Property Type -->
                                    <div class="col-md-3">
                                        <select name="property_type" class="form-select">
                                            <option value="">All Property Types</option>
                                            <t t-foreach="property_types" t-as="ptype">
                                                <option t-att-value="ptype.id"
                                                        t-att-selected="'selected' if filters.get('property_type') == ptype.id else None">
                                                    <t t-esc="ptype.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>

                                    <!-- Transaction Type -->
                                    <div class="col-md-3">
                                        <select name="transaction_type" class="form-select">
                                            <option value="">All Transactions</option>
                                            <option value="sale" t-att-selected="'selected' if filters.get('transaction_type') == 'sale' else None">For Sale</option>
                                            <option value="rent" t-att-selected="'selected' if filters.get('transaction_type') == 'rent' else None">For Rent</option>
                                            <option value="lease" t-att-selected="'selected' if filters.get('transaction_type') == 'lease' else None">For Lease</option>
                                        </select>
                                    </div>

                                    <!-- Sort By -->
                                    <div class="col-md-2">
                                        <select name="sortby" class="form-select">
                                            <option value="newest" t-att-selected="'selected' if sortby == 'newest' else None">Newest</option>
                                            <option value="price_low" t-att-selected="'selected' if sortby == 'price_low' else None">Price: Low to High</option>
                                            <option value="price_high" t-att-selected="'selected' if sortby == 'price_high' else None">Price: High to Low</option>
                                            <option value="name" t-att-selected="'selected' if sortby == 'name' else None">Name</option>
                                        </select>
                                    </div>
                                </div>

                                <!-- Advanced Filters (Collapsible) -->
                                <div class="row w-100 mt-3">
                                    <div class="col-12">
                                        <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#advancedFilters">
                                            Advanced Filters
                                        </button>
                                    </div>
                                </div>

                                <div class="collapse mt-3 w-100" id="advancedFilters">
                                    <div class="card card-body">
                                        <div class="row g-3">
                                            <!-- Price Range -->
                                            <div class="col-md-3">
                                                <label>Min Price</label>
                                                <input type="number" name="min_price" class="form-control"
                                                       placeholder="Min Price" t-att-value="filters.get('min_price')"/>
                                            </div>
                                            <div class="col-md-3">
                                                <label>Max Price</label>
                                                <input type="number" name="max_price" class="form-control"
                                                       placeholder="Max Price" t-att-value="filters.get('max_price')"/>
                                            </div>

                                            <!-- Bedrooms & Bathrooms -->
                                            <div class="col-md-2">
                                                <label>Min Bedrooms</label>
                                                <input type="number" name="bedrooms" class="form-control"
                                                       placeholder="Beds" t-att-value="filters.get('bedrooms')"/>
                                            </div>
                                            <div class="col-md-2">
                                                <label>Min Bathrooms</label>
                                                <input type="number" name="bathrooms" class="form-control"
                                                       placeholder="Baths" t-att-value="filters.get('bathrooms')"/>
                                            </div>

                                            <!-- Area -->
                                            <div class="col-md-3">
                                                <label>Min Area (sqm)</label>
                                                <input type="number" name="min_area" class="form-control"
                                                       placeholder="Min Area" t-att-value="filters.get('min_area')"/>
                                            </div>
                                            <div class="col-md-3">
                                                <label>Max Area (sqm)</label>
                                                <input type="number" name="max_area" class="form-control"
                                                       placeholder="Max Area" t-att-value="filters.get('max_area')"/>
                                            </div>

                                            <!-- City & Country -->
                                            <div class="col-md-3">
                                                <label>City</label>
                                                <input type="text" name="city" class="form-control"
                                                       placeholder="City" t-att-value="filters.get('city')"/>
                                            </div>
                                            <div class="col-md-3">
                                                <label>Country</label>
                                                <select name="country" class="form-select">
                                                    <option value="">All Countries</option>
                                                    <t t-foreach="countries" t-as="country">
                                                        <option t-att-value="country.id"
                                                                t-att-selected="'selected' if filters.get('country') == country.id else None">
                                                            <t t-esc="country.name"/>
                                                        </option>
                                                    </t>
                                                </select>
                                            </div>

                                            <!-- Parking -->
                                            <div class="col-md-2">
                                                <label>Min Parking</label>
                                                <input type="number" name="parking" class="form-control"
                                                       placeholder="Parking" t-att-value="filters.get('parking')"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row w-100 mt-3">
                                    <div class="col-12">
                                        <button type="submit" class="btn btn-primary">Search</button>
                                        <a href="/properties" class="btn btn-secondary ms-2">Clear Filters</a>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Property Grid -->
                    <div class="row">
                        <t t-if="properties">
                            <t t-foreach="properties" t-as="property">
                                <div class="col-lg-4 col-md-6 mb-4">
                                    <div class="card h-100 property-card">
                                        <a t-attf-href="/property/#{property.id}" class="text-decoration-none">
                                            <img t-if="property.image_main"
                                                 t-att-src="'data:image/png;base64,%s' % property.image_main.decode('utf-8')"
                                                 class="card-img-top" style="height: 250px; object-fit: cover;"
                                                 t-att-alt="property.name"/>
                                            <img t-else="" src="/web/static/img/placeholder.png"
                                                 class="card-img-top" style="height: 250px; object-fit: cover;"
                                                 alt="No Image"/>
                                        </a>
                                        <div class="card-body">
                                            <h5 class="card-title">
                                                <a t-attf-href="/property/#{property.id}" class="text-decoration-none text-dark">
                                                    <t t-esc="property.name"/>
                                                </a>
                                            </h5>
                                            <p class="text-muted mb-2">
                                                <i class="fa fa-map-marker me-1"/>
                                                <t t-esc="property.location"/>
                                            </p>
                                            <p class="mb-2">
                                                <span class="badge bg-info text-white">
                                                    <t t-if="property.transaction_type == 'sale'">For Sale</t>
                                                    <t t-elif="property.transaction_type == 'rent'">For Rent</t>
                                                    <t t-else="">For Lease</t>
                                                </span>
                                                <span class="badge bg-secondary ms-1" t-esc="property.property_type_id.name"/>
                                            </p>
                                            <h4 class="text-success mb-3">
                                                <t t-esc="property.price" t-options="{'widget': 'monetary', 'display_currency': property.currency_id}"/>
                                            </h4>
                                            <div class="d-flex justify-content-between text-muted small">
                                                <span t-if="property.bedrooms">
                                                    <i class="fa fa-bed"/> <t t-esc="property.bedrooms"/> BR
                                                </span>
                                                <span t-if="property.bathrooms">
                                                    <i class="fa fa-bath"/> <t t-esc="property.bathrooms"/> BA
                                                </span>
                                                <span t-if="property.building_area">
                                                    <i class="fa fa-arrows-alt"/> <t t-esc="property.building_area"/> sqm
                                                </span>
                                            </div>
                                        </div>
                                        <div class="card-footer bg-white">
                                            <a t-attf-href="/property/#{property.id}" class="btn btn-primary btn-sm w-100">
                                                View Details
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </t>
                        <t t-else="">
                            <div class="col-12">
                                <div class="alert alert-info text-center">
                                    <h4>No properties found</h4>
                                    <p>Try adjusting your search filters</p>
                                </div>
                            </div>
                        </t>
                    </div>

                    <!-- Pagination -->
                    <div class="row">
                        <div class="col-12">
                            <t t-call="website.pager"/>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Property Detail Page -->
    <template id="property_detail_page" name="Property Detail">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_property_detail">
                <!-- Property Header Banner -->
                <section class="bg-light py-4 mb-4">
                    <div class="container">
                        <!-- Success/Error Messages -->
                        <div t-if="request.params.get('inquiry_success')" class="alert alert-success alert-dismissible fade show">
                            <i class="fa fa-check-circle me-2"/>
                            <strong>Success!</strong> Your inquiry has been submitted successfully. We'll get back to you soon!
                            <button type="button" class="btn-close" data-bs-dismiss="alert"/>
                        </div>
                        <div t-if="request.params.get('inquiry_error')" class="alert alert-danger alert-dismissible fade show">
                            <i class="fa fa-exclamation-triangle me-2"/>
                            <strong>Error!</strong> There was a problem submitting your inquiry. Please try again.
                            <button type="button" class="btn-close" data-bs-dismiss="alert"/>
                        </div>

                        <!-- Breadcrumb -->
                        <nav aria-label="breadcrumb" class="mb-3">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item"><a href="/"><i class="fa fa-home"/> Home</a></li>
                                <li class="breadcrumb-item"><a href="/properties">Properties</a></li>
                                <li class="breadcrumb-item active" t-esc="property.name"/>
                            </ol>
                        </nav>

                        <!-- Property Header -->
                        <div class="row align-items-center">
                            <div class="col-lg-8">
                                <div class="d-flex align-items-start gap-3 mb-3">
                                    <div class="flex-grow-1">
                                        <h1 class="mb-2 fw-bold" t-esc="property.name"/>
                                        <p class="text-muted mb-2 fs-5">
                                            <i class="fa fa-map-marker text-primary me-2"/>
                                            <t t-esc="property.location"/>
                                        </p>
                                        <div class="d-flex gap-2 flex-wrap">
                                            <span class="badge bg-primary fs-6" t-esc="property.property_type_id.name"/>
                                            <span class="badge bg-info fs-6">
                                                <t t-if="property.transaction_type == 'sale'">For Sale</t>
                                                <t t-elif="property.transaction_type == 'rent'">For Rent</t>
                                                <t t-else="">For Lease</t>
                                            </span>
                                            <span t-if="property.is_featured" class="badge bg-warning text-dark fs-6">
                                                <i class="fa fa-star"/> Featured
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-4 text-lg-end">
                                <div class="bg-white p-3 rounded shadow-sm">
                                    <p class="text-muted mb-1 small">Price</p>
                                    <h2 class="text-success mb-0 fw-bold">
                                        <t t-esc="property.price" t-options="{'widget': 'monetary', 'display_currency': property.currency_id}"/>
                                    </h2>
                                    <p t-if="property.transaction_type in ['rent', 'lease'] and property.monthly_rent" class="mb-0 small text-muted">
                                        <t t-esc="property.monthly_rent" t-options="{'widget': 'monetary', 'display_currency': property.currency_id}"/> /month
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Quick Stats -->
                        <div class="row g-3 mt-3">
                            <div class="col-6 col-md-3" t-if="property.bedrooms">
                                <div class="bg-white p-3 rounded text-center">
                                    <i class="fa fa-bed fa-2x text-primary mb-2"/>
                                    <h5 class="mb-0" t-esc="property.bedrooms"/>
                                    <small class="text-muted">Bedrooms</small>
                                </div>
                            </div>
                            <div class="col-6 col-md-3" t-if="property.bathrooms">
                                <div class="bg-white p-3 rounded text-center">
                                    <i class="fa fa-bath fa-2x text-primary mb-2"/>
                                    <h5 class="mb-0" t-esc="property.bathrooms"/>
                                    <small class="text-muted">Bathrooms</small>
                                </div>
                            </div>
                            <div class="col-6 col-md-3" t-if="property.building_area">
                                <div class="bg-white p-3 rounded text-center">
                                    <i class="fa fa-arrows-alt fa-2x text-primary mb-2"/>
                                    <h5 class="mb-0"><t t-esc="property.building_area"/> m²</h5>
                                    <small class="text-muted">Building Area</small>
                                </div>
                            </div>
                            <div class="col-6 col-md-3" t-if="property.parking_spaces">
                                <div class="bg-white p-3 rounded text-center">
                                    <i class="fa fa-car fa-2x text-primary mb-2"/>
                                    <h5 class="mb-0" t-esc="property.parking_spaces"/>
                                    <small class="text-muted">Parking</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="container mb-5">

                    <div class="row">
                        <!-- Main Content -->
                        <div class="col-lg-8">
                            <!-- Main Image -->
                            <div class="mb-4 position-relative">
                                <div class="property-main-image rounded overflow-hidden shadow">
                                    <img t-if="property.image_main"
                                         t-att-src="'data:image/png;base64,%s' % property.image_main.decode('utf-8')"
                                         class="img-fluid w-100" style="height: 450px; object-fit: cover;"
                                         t-att-alt="property.name"/>
                                    <img t-else="" src="/web/static/img/placeholder.png"
                                         class="img-fluid w-100" style="height: 450px; object-fit: cover;"
                                         alt="No Image"/>
                                </div>
                                <div class="position-absolute top-0 end-0 m-3">
                                    <span class="badge bg-dark bg-opacity-75 px-3 py-2">
                                        <i class="fa fa-eye"/> <t t-esc="property.views_count"/> Views
                                    </span>
                                </div>
                            </div>

                            <!-- Image Gallery -->
                            <div t-if="property.image_ids" class="mb-4">
                                <h5 class="mb-3"><i class="fa fa-images me-2"/>Photo Gallery</h5>
                                <div class="row g-3">
                                    <t t-foreach="property.image_ids[:8]" t-as="img">
                                        <div class="col-6 col-md-3">
                                            <div class="property-gallery-item rounded overflow-hidden shadow-sm">
                                                <img t-att-src="'data:image/png;base64,%s' % img.image_small.decode('utf-8')"
                                                     class="img-fluid w-100" style="height: 120px; object-fit: cover; cursor: pointer;"
                                                     t-att-alt="img.name or 'Property Image'"/>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>

                            <!-- Floor Plan -->
                            <div class="card border-0 shadow-sm mb-4" t-if="property.floor_plan">
                                <div class="card-header bg-white border-bottom">
                                    <h5 class="mb-0"><i class="fa fa-file-image-o me-2 text-primary"/>Floor Plan</h5>
                                </div>
                                <div class="card-body p-4">
                                    <div class="text-center">
                                        <a t-attf-href="/web/content?model=property.property&amp;id=#{property.id}&amp;field=floor_plan&amp;filename=#{property.floor_plan_filename or 'floor_plan'}"
                                           target="_blank"
                                           class="btn btn-primary btn-lg mb-3">
                                            <i class="fa fa-download me-2"/>Download Floor Plan
                                        </a>
                                        <p class="text-muted mb-0">
                                            <i class="fa fa-file-pdf-o me-1"/>
                                            <t t-esc="property.floor_plan_filename or 'floor_plan.pdf'"/>
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- Description -->
                            <div class="card border-0 shadow-sm mb-4">
                                <div class="card-header bg-white border-bottom">
                                    <h4 class="mb-0"><i class="fa fa-align-left me-2 text-primary"/>Description</h4>
                                </div>
                                <div class="card-body p-4">
                                    <t t-if="property.description">
                                        <div class="property-description">
                                            <t t-raw="property.description"/>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <p class="text-muted mb-0"><i class="fa fa-info-circle"/> No description available</p>
                                    </t>
                                </div>
                            </div>

                            <!-- Property Details -->
                            <div class="card border-0 shadow-sm mb-4">
                                <div class="card-header bg-white border-bottom">
                                    <h4 class="mb-0"><i class="fa fa-list-ul me-2 text-primary"/>Property Details</h4>
                                </div>
                                <div class="card-body p-4">
                                    <div class="row g-3">
                                        <div class="col-md-6" t-if="property.property_type_id">
                                            <div class="d-flex align-items-center p-3 bg-light rounded">
                                                <i class="fa fa-building fa-2x text-primary me-3"/>
                                                <div>
                                                    <small class="text-muted d-block">Property Type</small>
                                                    <strong t-esc="property.property_type_id.name"/>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6" t-if="property.property_condition">
                                            <div class="d-flex align-items-center p-3 bg-light rounded">
                                                <i class="fa fa-check-circle fa-2x text-success me-3"/>
                                                <div>
                                                    <small class="text-muted d-block">Condition</small>
                                                    <strong t-esc="property.property_condition.replace('_', ' ').title()"/>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6" t-if="property.year_built">
                                            <div class="d-flex align-items-center p-3 bg-light rounded">
                                                <i class="fa fa-calendar fa-2x text-warning me-3"/>
                                                <div>
                                                    <small class="text-muted d-block">Year Built</small>
                                                    <strong t-esc="property.year_built"/>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6" t-if="property.land_area">
                                            <div class="d-flex align-items-center p-3 bg-light rounded">
                                                <i class="fa fa-map fa-2x text-info me-3"/>
                                                <div>
                                                    <small class="text-muted d-block">Land Area</small>
                                                    <strong><t t-esc="property.land_area"/> m²</strong>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6" t-if="property.number_of_floors">
                                            <div class="d-flex align-items-center p-3 bg-light rounded">
                                                <i class="fa fa-layer-group fa-2x text-secondary me-3"/>
                                                <div>
                                                    <small class="text-muted d-block">Number of Floors</small>
                                                    <strong t-esc="property.number_of_floors"/>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6" t-if="property.number_of_apartments">
                                            <div class="d-flex align-items-center p-3 bg-light rounded">
                                                <i class="fa fa-home fa-2x text-danger me-3"/>
                                                <div>
                                                    <small class="text-muted d-block">Number of Apartments</small>
                                                    <strong t-esc="property.number_of_apartments"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Amenities -->
                            <div class="card border-0 shadow-sm mb-4" t-if="property.amenity_ids">
                                <div class="card-header bg-white border-bottom">
                                    <h4 class="mb-0"><i class="fa fa-star me-2 text-primary"/>Amenities &amp; Features</h4>
                                </div>
                                <div class="card-body p-4">
                                    <div class="row g-2">
                                        <t t-foreach="property.amenity_ids" t-as="amenity">
                                            <div class="col-6 col-md-4">
                                                <div class="d-flex align-items-center p-2 bg-light rounded">
                                                    <i t-if="amenity.icon" t-attf-class="fa #{amenity.icon} fa-lg text-success me-2"/>
                                                    <i t-else="" class="fa fa-check-circle fa-lg text-success me-2"/>
                                                    <span t-esc="amenity.name"/>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Sidebar -->
                        <div class="col-lg-4">
                            <!-- Inquiry Form -->
                            <div class="card border-0 shadow-lg mb-4 sticky-top" style="top: 20px;">
                                <div class="card-header bg-gradient text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                    <h5 class="mb-0"><i class="fa fa-envelope me-2"/>Contact Property Owner</h5>
                                </div>
                                <div class="card-body p-4">
                                    <form t-attf-action="/property/#{property.id}/inquiry" method="post" class="property-inquiry-form">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                        <div class="mb-3" t-if="not request.env.user._is_public()">
                                            <div class="alert alert-info py-2">
                                                <i class="fa fa-user-circle me-2"/>
                                                <small>Logged in as: <strong t-esc="request.env.user.name"/></small>
                                            </div>
                                        </div>

                                        <div class="mb-3" t-if="request.env.user._is_public()">
                                            <label for="name" class="form-label fw-bold">
                                                <i class="fa fa-user text-primary me-1"/>Your Name*
                                            </label>
                                            <input type="text" class="form-control form-control-lg" id="name" name="name"
                                                   placeholder="Enter your full name" required="required"/>
                                        </div>

                                        <div class="mb-3" t-if="request.env.user._is_public()">
                                            <label for="email" class="form-label fw-bold">
                                                <i class="fa fa-envelope text-primary me-1"/>Email*
                                            </label>
                                            <input type="email" class="form-control form-control-lg" id="email" name="email"
                                                   placeholder="your.email@example.com" required="required"/>
                                        </div>

                                        <div class="mb-3" t-if="request.env.user._is_public()">
                                            <label for="phone" class="form-label fw-bold">
                                                <i class="fa fa-phone text-primary me-1"/>Phone
                                            </label>
                                            <input type="tel" class="form-control form-control-lg" id="phone" name="phone"
                                                   placeholder="+1 (555) 123-4567"/>
                                        </div>

                                        <div class="mb-3">
                                            <label for="subject" class="form-label fw-bold">
                                                <i class="fa fa-tag text-primary me-1"/>Subject*
                                            </label>
                                            <input type="text" class="form-control form-control-lg" id="subject" name="subject"
                                                   value="Inquiry about Property" required="required"/>
                                        </div>

                                        <div class="mb-3">
                                            <label for="message" class="form-label fw-bold">
                                                <i class="fa fa-comment text-primary me-1"/>Message*
                                            </label>
                                            <textarea class="form-control" id="message" name="message" rows="5"
                                                      required="required" placeholder="I'm interested in this property and would like to schedule a viewing..."/>
                                        </div>

                                        <button type="submit" class="btn btn-lg btn-primary w-100 shadow">
                                            <i class="fa fa-paper-plane me-2"/>Send Inquiry
                                        </button>
                                        <small class="text-muted d-block mt-2 text-center">
                                            <i class="fa fa-lock me-1"/>Your information is secure
                                        </small>
                                    </form>
                                </div>
                            </div>

                            <!-- Property Information Card -->
                            <div class="card border-0 shadow-sm mb-4">
                                <div class="card-header bg-white border-bottom">
                                    <h5 class="mb-0"><i class="fa fa-info-circle me-2 text-primary"/>Property Information</h5>
                                </div>
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                                        <span class="text-muted">
                                            <i class="fa fa-hashtag me-1"/>Reference
                                        </span>
                                        <strong t-esc="property.reference"/>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                                        <span class="text-muted">
                                            <i class="fa fa-eye me-1"/>Views
                                        </span>
                                        <span class="badge bg-secondary"><t t-esc="property.views_count"/> views</span>
                                    </div>
                                    <div t-if="property.is_featured">
                                        <div class="alert alert-warning py-2 mb-0">
                                            <i class="fa fa-star me-2"/>
                                            <strong>Featured Property</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Share Buttons -->
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-white border-bottom">
                                    <h5 class="mb-0"><i class="fa fa-share-alt me-2 text-primary"/>Share This Property</h5>
                                </div>
                                <div class="card-body p-3">
                                    <div class="d-grid gap-2">
                                        <button class="btn btn-outline-primary btn-sm">
                                            <i class="fa fa-facebook me-2"/>Share on Facebook
                                        </button>
                                        <button class="btn btn-outline-info btn-sm">
                                            <i class="fa fa-twitter me-2"/>Share on Twitter
                                        </button>
                                        <button class="btn btn-outline-success btn-sm">
                                            <i class="fa fa-whatsapp me-2"/>Share on WhatsApp
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm">
                                            <i class="fa fa-link me-2"/>Copy Link
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Similar Properties -->
                    <div class="row mt-5" t-if="similar_properties">
                        <div class="col-12">
                            <h3 class="mb-4">Similar Properties</h3>
                        </div>
                        <t t-foreach="similar_properties" t-as="similar">
                            <div class="col-lg-3 col-md-6 mb-4">
                                <div class="card h-100">
                                    <a t-attf-href="/property/#{similar.id}">
                                        <img t-if="similar.image_main"
                                             t-att-src="'data:image/png;base64,%s' % similar.image_main.decode('utf-8')"
                                             class="card-img-top" style="height: 200px; object-fit: cover;"
                                             t-att-alt="similar.name"/>
                                        <img t-else="" src="/web/static/img/placeholder.png"
                                             class="card-img-top" style="height: 200px; object-fit: cover;" alt="No Image"/>
                                    </a>
                                    <div class="card-body">
                                        <h6 class="card-title">
                                            <a t-attf-href="/property/#{similar.id}" class="text-decoration-none text-dark">
                                                <t t-esc="similar.name[:40]"/>
                                            </a>
                                        </h6>
                                        <p class="text-success mb-2">
                                            <strong t-esc="similar.price" t-options="{'widget': 'monetary', 'display_currency': similar.currency_id}"/>
                                        </p>
                                        <a t-attf-href="/property/#{similar.id}" class="btn btn-sm btn-outline-primary">View</a>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Website Menu Item -->
    <record id="menu_property_listing" model="website.menu">
        <field name="name">Properties</field>
        <field name="url">/properties</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence">50</field>
    </record>
</odoo>
