<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tenancy List View -->
    <record id="property_tenancy_view_tree" model="ir.ui.view">
        <field name="name">property.tenancy.list</field>
        <field name="model">property.tenancy</field>
        <field name="arch" type="xml">
            <list string="Tenancies" sample="1"
                  decoration-info="state == 'active'"
                  decoration-success="state == 'approved'"
                  decoration-warning="state == 'pending'"
                  decoration-muted="state in ('expired', 'cancelled')">
                <field name="reference" optional="show"/>
                <field name="name"/>
                <field name="property_id"/>
                <field name="tenant_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="duration_months" optional="hide"/>
                <field name="rent_amount" widget="monetary" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="rent_payment_term" optional="hide"/>
                <field name="total_rent_outstanding" widget="monetary" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Tenancy Form View -->
    <record id="property_tenancy_view_form" model="ir.ui.view">
        <field name="name">property.tenancy.form</field>
        <field name="model">property.tenancy</field>
        <field name="arch" type="xml">
            <form string="Tenancy Contract">
                <header>
                    <button name="action_submit_approval" string="Submit for Approval"
                            type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_approve" string="Approve &amp; Activate"
                            type="object" invisible="state != 'pending'"
                            class="oe_highlight" groups="property_management.group_property_manager"/>
                    <button name="action_terminate" string="Terminate Contract"
                            type="object" invisible="state != 'active'" class="btn-warning"/>
                    <button name="action_renew" string="Renew Contract"
                            type="object" invisible="state not in ('active', 'expired')" class="oe_highlight"/>
                    <button name="action_cancel" string="Cancel"
                            type="object" invisible="state in ('terminated', 'cancelled')"/>
                    <button name="action_set_draft" string="Set to Draft"
                            type="object" invisible="state not in ('rejected', 'cancelled')"/>
                    <button name="action_generate_rent_invoices" string="Generate Invoices"
                            type="object" class="btn-primary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending,active"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_rent_invoices" type="object"
                                class="oe_stat_button" icon="fa-money">
                            <field name="rent_invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                        <button name="action_view_maintenance" type="object"
                                class="oe_stat_button" icon="fa-wrench">
                            <field name="maintenance_count" widget="statinfo" string="Maintenance"/>
                        </button>
                        <button name="toggle_active" type="object"
                                class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options="{'terminology': 'archive'}"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="Contract Name"/>
                        <h1>
                            <field name="name" placeholder="e.g., Tenancy Agreement 2024"/>
                        </h1>
                        <div>
                            <span class="badge text-bg-secondary">
                                <field name="reference" readonly="1"/>
                            </span>
                        </div>
                    </div>

                    <group>
                        <group string="Parties">
                            <field name="property_id" options="{'no_create': True}"/>
                            <field name="tenant_id"/>
                            <field name="landlord_id" readonly="1"/>
                        </group>
                        <group string="Contract Period">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="duration_months" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <group string="Rent Details">
                            <label for="rent_amount" class="fw-bold"/>
                            <div class="o_row">
                                <field name="rent_amount" widget="monetary"/>
                                <field name="currency_id" invisible="1"/>
                            </div>
                            <field name="rent_payment_term"/>
                            <field name="rent_payment_day"/>
                            <field name="maintenance_fee" widget="monetary"/>
                            <field name="parking_fee" widget="monetary"/>
                        </group>
                        <group string="Security Deposit">
                            <field name="security_deposit" widget="monetary"/>
                            <field name="deposit_paid" widget="boolean_toggle"/>
                            <field name="deposit_paid_date" invisible="not deposit_paid"/>
                            <field name="deposit_refunded" invisible="not deposit_paid"/>
                            <field name="deposit_refund_date" invisible="not deposit_refunded"/>
                            <field name="deposit_refund_amount" invisible="not deposit_refunded" widget="monetary"/>
                        </group>
                    </group>

                    <group>
                        <group string="Payment Summary" invisible="state == 'draft'">
                            <field name="total_rent_due" widget="monetary" readonly="1"/>
                            <field name="total_rent_paid" widget="monetary" readonly="1"/>
                            <field name="total_rent_outstanding" widget="monetary" readonly="1"
                                   class="text-danger fw-bold"/>
                        </group>
                        <group string="Additional Options">
                            <field name="utility_included" widget="boolean_toggle"/>
                            <field name="parking_included" widget="boolean_toggle"/>
                            <field name="is_renewable" widget="boolean_toggle"/>
                            <field name="auto_renew" widget="boolean_toggle" invisible="not is_renewable"/>
                            <field name="renewal_period_months" invisible="not is_renewable"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Terms &amp; Conditions" name="terms">
                            <field name="terms_and_conditions" placeholder="Enter contract terms and conditions..."/>
                        </page>

                        <page string="Special Clauses" name="clauses">
                            <group>
                                <field name="special_clauses" nolabel="1" placeholder="Any special conditions or clauses..."/>
                            </group>
                        </page>

                        <page string="Occupants" name="occupants">
                            <group>
                                <group>
                                    <field name="number_of_occupants"/>
                                    <field name="occupant_names" placeholder="List names of all occupants..."/>
                                </group>
                            </group>
                        </page>

                        <page string="Notice Period &amp; Termination" name="notice">
                            <group>
                                <group>
                                    <field name="notice_period_days"/>
                                    <field name="termination_notice_date"/>
                                    <field name="termination_reason"/>
                                </group>
                            </group>
                        </page>

                        <page string="Contract Document" name="document">
                            <group>
                                <group>
                                    <field name="contract_document" filename="contract_filename" widget="binary"/>
                                    <field name="contract_filename" invisible="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Internal Notes" name="notes">
                            <field name="notes" placeholder="Internal notes about this tenancy..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Tenancy Kanban View -->
    <record id="property_tenancy_view_kanban" model="ir.ui.view">
        <field name="name">property.tenancy.kanban</field>
        <field name="model">property.tenancy</field>
        <field name="arch" type="xml">
            <kanban string="Tenancies" sample="1" class="o_kanban_mobile">
                <field name="id"/>
                <field name="name"/>
                <field name="property_id"/>
                <field name="tenant_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="rent_amount"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="total_rent_outstanding"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="text-muted">
                                    <i class="fa fa-building text-primary"/> <field name="property_id"/>
                                </div>
                                <div class="text-muted">
                                    <i class="fa fa-user text-info"/> <field name="tenant_id"/>
                                </div>
                                <div class="mt-2">
                                    <i class="fa fa-calendar"/>
                                    <field name="date_start"/> - <field name="date_end"/>
                                </div>
                                <div class="mt-2">
                                    <strong class="text-success">
                                        <field name="rent_amount" widget="monetary"/>
                                        <span class="text-muted small">/month</span>
                                    </strong>
                                </div>
                                <div t-if="record.total_rent_outstanding.raw_value > 0" class="mt-2">
                                    <span class="text-danger">
                                        Outstanding: <field name="total_rent_outstanding" widget="monetary"/>
                                    </span>
                                </div>
                                <div class="mt-2">
                                    <field name="state" widget="badge"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Tenancy Search View -->
    <record id="property_tenancy_view_search" model="ir.ui.view">
        <field name="name">property.tenancy.search</field>
        <field name="model">property.tenancy</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="property_id"/>
                <field name="tenant_id"/>
                <filter string="Active" name="active" domain="[('state','=','active')]"/>
                <filter string="Expired" name="expired" domain="[('state','=','expired')]"/>
            </search>
        </field>
    </record>

    <!-- Tenancy Action -->
    <record id="property_tenancy_action" model="ir.actions.act_window">
        <field name="name">Tenancies</field>
        <field name="res_model">property.tenancy</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first tenancy contract
            </p>
            <p>
                Manage rental agreements with automated rent invoicing and payment tracking.
            </p>
        </field>
    </record>
</odoo>
