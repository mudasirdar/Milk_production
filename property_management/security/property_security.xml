<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security Groups -->
    <record id="module_property_management" model="ir.module.category">
        <field name="name">Property Management</field>
        <field name="description">Manage property listings and real estate transactions</field>
        <field name="sequence">10</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_property">
        <field name="name">Property</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_property_management"/>
    </record>

    <record id="group_property_user" model="res.groups">
        <field name="name">User</field>
        <field name="comment">Can manage own properties</field>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_property"/>
    </record>

    <record id="group_property_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="comment">Can manage all properties and approve listings</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_property"/>
        <field name="implied_ids" eval="[(4, ref('group_property_user'))]"/>
    </record>

    <!-- Record Rules -->
    <!-- Property: Users can only see their own properties and published ones -->
    <record id="property_property_rule_user" model="ir.rule">
        <field name="name">Property: User - Own and Published Properties</field>
        <field name="model_id" ref="model_property_property"/>
        <field name="domain_force">['|', ('owner_id', '=', user.partner_id.id), ('state', 'in', ['published', 'approved'])]</field>
        <field name="groups" eval="[(4, ref('group_property_user'))]"/>
    </record>

    <!-- Property: Managers can see all properties -->
    <record id="property_property_rule_manager" model="ir.rule">
        <field name="name">Property: Manager - All Properties</field>
        <field name="model_id" ref="model_property_property"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_property_manager'))]"/>
    </record>

    <!-- Property Inquiry: Users can see inquiries for their properties -->
    <record id="property_inquiry_rule_user" model="ir.rule">
        <field name="name">Property Inquiry: User - Own Property Inquiries</field>
        <field name="model_id" ref="model_property_inquiry"/>
        <field name="domain_force">['|', ('property_owner_id', '=', user.partner_id.id), ('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_property_user'))]"/>
    </record>

    <!-- Property Inquiry: Managers can see all inquiries -->
    <record id="property_inquiry_rule_manager" model="ir.rule">
        <field name="name">Property Inquiry: Manager - All Inquiries</field>
        <field name="model_id" ref="model_property_inquiry"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_property_manager'))]"/>
    </record>

    <!-- Property Type and Amenity: All users can read -->
    <record id="property_type_rule_all" model="ir.rule">
        <field name="name">Property Type: All Users</field>
        <field name="model_id" ref="model_property_type"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="property_amenity_rule_all" model="ir.rule">
        <field name="name">Property Amenity: All Users</field>
        <field name="model_id" ref="model_property_amenity"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Portal Rules: Portal users can see published properties -->
    <record id="property_property_rule_portal" model="ir.rule">
        <field name="name">Property: Portal - Published Properties</field>
        <field name="model_id" ref="model_property_property"/>
        <field name="domain_force">[('website_published', '=', True), ('state', '=', 'published')]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Public Users: Can view published properties on website -->
    <record id="property_property_rule_public" model="ir.rule">
        <field name="name">Property: Public - Published Properties</field>
        <field name="model_id" ref="model_property_property"/>
        <field name="domain_force">[('website_published', '=', True), ('state', '=', 'published')]</field>
        <field name="groups" eval="[(4, ref('base.group_public'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Sequences -->
    <record id="seq_property_property" model="ir.sequence">
        <field name="name">Property Sequence</field>
        <field name="code">property.property</field>
        <field name="prefix">PROP</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_property_tenant" model="ir.sequence">
        <field name="name">Tenant Sequence</field>
        <field name="code">property.tenant</field>
        <field name="prefix">TEN</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_property_tenancy" model="ir.sequence">
        <field name="name">Tenancy Sequence</field>
        <field name="code">property.tenancy</field>
        <field name="prefix">CONT</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_property_rent_invoice" model="ir.sequence">
        <field name="name">Rent Invoice Sequence</field>
        <field name="code">property.rent.invoice</field>
        <field name="prefix">RENT</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_property_maintenance" model="ir.sequence">
        <field name="name">Maintenance Sequence</field>
        <field name="code">property.maintenance</field>
        <field name="prefix">MAINT</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_property_valuation" model="ir.sequence">
        <field name="name">Valuation Sequence</field>
        <field name="code">property.valuation</field>
        <field name="prefix">VAL</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_property_insurance" model="ir.sequence">
        <field name="name">Insurance Sequence</field>
        <field name="code">property.insurance</field>
        <field name="prefix">INS</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_property_utility" model="ir.sequence">
        <field name="name">Utility Sequence</field>
        <field name="code">property.utility</field>
        <field name="prefix">UTIL</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>
</odoo>
