<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Header button on Sale Order form -->
    <record id="view_order_form_textbee_sms" model="ir.ui.view">
        <field name="name">sale.order.form.textbee.sms</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_textbee_sms"
                        string="Send Textbee SMS"
                        type="object"
                        class="btn-primary"/>
            </xpath>
        </field>
    </record>

    <!-- Server action for Action menu -->
    <record id="action_send_textbee_sms_sale" model="ir.actions.server">
        <field name="name">Send Textbee SMS</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">form,list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    records.action_send_textbee_sms()
        </field>
    </record>

</odoo>
