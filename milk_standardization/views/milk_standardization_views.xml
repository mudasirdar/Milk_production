<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Form View ──────────────────────────────────────────────────── -->
    <record id="view_milk_standardization_form" model="ir.ui.view">
        <field name="name">milk.standardization.form</field>
        <field name="model">milk.standardization</field>
        <field name="arch" type="xml">
            <form string="Milk Standardization" class="o_milk_standardization_form">
                <header>
                    <!-- Single Output Mode Buttons -->
                    <button name="action_confirm_water" string="Step 1: Confirm Water Added"
                            type="object" class="btn-primary"
                            invisible="state != 'draft' or use_multi_output"/>
                    <button name="action_confirm_snf" string="Step 2: Confirm SMP Added"
                            type="object" class="btn-primary"
                            invisible="state != 'step1' or use_multi_output"/>
                    <button name="action_done" string="Step 3: Complete Standardization"
                            type="object" class="btn-success"
                            invisible="state != 'step2' or use_multi_output"/>

                    <!-- Multi Output Mode Buttons -->
                    <button name="action_confirm_water_multi" string="Step 1: Confirm Water Added"
                            type="object" class="btn-primary"
                            invisible="state != 'draft' or not use_multi_output"/>
                    <button name="action_confirm_snf_multi" string="Step 2: Confirm SMP Added"
                            type="object" class="btn-primary"
                            invisible="state != 'step1' or not use_multi_output"/>
                    <button name="action_done_multi" string="Step 3: Complete Standardization"
                            type="object" class="btn-success"
                            invisible="state != 'step2' or not use_multi_output"/>

                    <button name="action_reset" string="Reset to Draft"
                            type="object" class="btn-secondary"
                            invisible="state in ('draft', 'done')" confirm="This will reset to draft. Continue?"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,step1,step2,done"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_pickings" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="picking_count == 0">
                            <field name="picking_count" widget="statinfo" string="Receipts"/>
                        </button>
                        <button name="action_view_stock_moves" type="object"
                                class="oe_stat_button" icon="fa-exchange"
                                invisible="move_count == 0 or use_mrp">
                            <field name="move_count" widget="statinfo" string="Stock Moves"/>
                        </button>
                        <button name="action_view_manufacturing_order" type="object"
                                class="oe_stat_button" icon="fa-industry"
                                invisible="not production_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="production_state" readonly="1"/></span>
                                <span class="o_stat_text">Manufacturing</span>
                            </div>
                        </button>
                        <button name="action_view_output_lines" type="object"
                                class="oe_stat_button" icon="fa-cubes"
                                invisible="not use_multi_output or line_count == 0">
                            <field name="line_count" widget="statinfo" string="Categories"/>
                        </button>
                    </div>

                    <!-- Title and Reference -->
                    <div class="oe_title mb-3">
                        <h1><field name="name" readonly="1" class="text-primary"/></h1>
                    </div>

                    <!-- Basic Info Row -->
                    <group>
                        <group string="Configuration">
                            <field name="date"/>
                            <field name="raw_milk_product_id" readonly="state != 'draft'"/>
                            <field name="product_id" readonly="state != 'draft'" invisible="use_multi_output"/>
                            <field name="location_id" readonly="state != 'draft'"/>
                        </group>
                        <group string="Mode">
                            <field name="use_multi_output" widget="boolean_toggle" readonly="state != 'draft'"/>
                            <field name="use_mrp" widget="boolean_toggle" readonly="state != 'draft' or production_id"
                                   invisible="use_multi_output"/>
                            <field name="bom_id" invisible="not use_mrp or use_multi_output"
                                   readonly="state != 'draft' or production_id"/>
                            <field name="production_id" readonly="1" invisible="not production_id"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- ════════════════════════════════════════════════════════════════════ -->
                        <!-- SINGLE OUTPUT MODE -->
                        <!-- ════════════════════════════════════════════════════════════════════ -->

                        <!-- DRAFT: Step 1 - Fat Standardization -->
                        <page string="1. Fat Standardization" name="single_step1"
                              invisible="use_multi_output or state not in ['draft']">

                            <!-- Raw Milk Input Card -->
                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <div class="card">
                                        <div class="card-header bg-primary text-white">
                                            <strong>Raw Milk Input</strong>
                                        </div>
                                        <div class="card-body">
                                            <group>
                                                <field name="aggregate_qty" string="Quantity (Liters)"/>
                                                <field name="aggregate_fat" string="Current Fat %"/>
                                                <field name="aggregate_snf" string="Current SNF %"/>
                                            </group>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card">
                                        <div class="card-header bg-secondary text-white">
                                            <strong>Target Values</strong>
                                        </div>
                                        <div class="card-body">
                                            <group>
                                                <field name="target_fat" string="Target Fat %"/>
                                                <field name="target_snf" string="Target SNF %"/>
                                                <field name="smp_snf_percent" string="SMP SNF Content %"/>
                                            </group>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Fat Standardization Card -->
                            <div class="row mb-4" invisible="aggregate_qty == 0 or aggregate_fat == 0">
                                <div class="col-12">
                                    <div class="card border-info">
                                        <div class="card-header bg-info text-white">
                                            <strong>Step 1: FAT STANDARDIZATION (Add Water)</strong>
                                        </div>
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-md-4 text-center border-end">
                                                    <h6 class="text-muted">Current Fat</h6>
                                                    <h2 class="text-danger"><field name="aggregate_fat" readonly="1" nolabel="1"/>%</h2>
                                                </div>
                                                <div class="col-md-4 text-center border-end">
                                                    <h6 class="text-muted">Water to Add</h6>
                                                    <h2 class="text-primary"><field name="water_to_add" readonly="1" nolabel="1"/> L</h2>
                                                </div>
                                                <div class="col-md-4 text-center">
                                                    <h6 class="text-muted">Target Fat</h6>
                                                    <h2 class="text-success"><field name="target_fat" readonly="1" nolabel="1"/>%</h2>
                                                </div>
                                            </div>
                                            <hr/>
                                            <group>
                                                <group>
                                                    <field name="water_consumed" string="Actual Water to Use (L)"/>
                                               </group>
                                            </group>
                                            <div class="alert alert-warning mt-3" role="alert" invisible="water_to_add == 0">
                                                <strong>Action:</strong>
                                                Add <strong><field name="water_to_add" readonly="1" nolabel="1"/> Liters</strong> of water
                                                to reduce Fat from <strong><field name="aggregate_fat" readonly="1" nolabel="1"/>%</strong>
                                                to <strong><field name="target_fat" readonly="1" nolabel="1"/>%</strong>.
                                                Then click <strong>"Step 1: Confirm Water Added"</strong>.
                                            </div>
                                            <div class="alert alert-success mt-3" role="alert" invisible="water_to_add != 0 or aggregate_fat == 0">
                                                <strong>No water needed!</strong>
                                                Current Fat (<field name="aggregate_fat" readonly="1" nolabel="1"/>%) is already at or below target (<field name="target_fat" readonly="1" nolabel="1"/>%).
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </page>

                        <!-- STEP1: Step 2 - SNF Standardization -->
                        <page string="2. SNF Standardization" name="single_step2"
                              invisible="use_multi_output or state != 'step1'">

                            <!-- Fat Standardization Complete Banner -->
                            <div class="alert alert-success mb-4" role="alert">
                                <strong>Step 1 Complete: Fat Standardized!</strong>
                                <span class="ms-3">Water Added: <strong><field name="water_consumed" readonly="1" nolabel="1"/> L</strong></span>
                                <span class="ms-3">|</span>
                                <span class="ms-3">Total Milk: <strong><field name="milk_after_water" readonly="1" nolabel="1"/> L</strong></span>
                                <span class="ms-3">|</span>
                                <span class="ms-3">Fat: <strong><field name="target_fat" readonly="1" nolabel="1"/>%</strong></span>
                            </div>

                            <!-- SNF Standardization Card -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <div class="card border-warning">
                                        <div class="card-header bg-warning">
                                            <strong>Step 2: SNF STANDARDIZATION (Add SMP)</strong>
                                        </div>
                                        <div class="card-body">
                                            <!-- SNF Values Display -->
                                            <div class="row mb-4">
                                                <div class="col-md-3 text-center border-end">
                                                    <h6 class="text-muted">Estimated SNF</h6>
                                                    <h3 class="text-secondary"><field name="snf_after_water_estimated" readonly="1" nolabel="1"/>%</h3>
                                                    <small class="text-muted">(after dilution)</small>
                                                </div>
                                                <div class="col-md-3 text-center border-end">
                                                    <h6 class="text-muted">Measured SNF</h6>
                                                    <h3 class="text-danger">
                                                        <field name="snf_after_water" nolabel="1" placeholder="Enter..."/>%
                                                    </h3>
                                                    <small class="text-muted">(from lab test)</small>
                                                </div>
                                                <div class="col-md-3 text-center border-end">
                                                    <h6 class="text-muted">SMP to Add</h6>
                                                    <h3 class="text-primary"><field name="smp_to_add" readonly="1" nolabel="1"/> Kg</h3>
                                                    <small class="text-muted">(calculated)</small>
                                                </div>
                                                <div class="col-md-3 text-center">
                                                    <h6 class="text-muted">Target SNF</h6>
                                                    <h3 class="text-success"><field name="target_snf" readonly="1" nolabel="1"/>%</h3>
                                                </div>
                                            </div>

                                            <hr/>

                                            <group invisible="snf_after_water == 0">
                                                <group>
                                                    <field name="snf_deficit" string="SNF Deficit %" readonly="1"
                                                           decoration-danger="snf_deficit > 0"
                                                           decoration-success="snf_deficit &lt;= 0"/>
                                                    <field name="smp_consumed" string="Actual SMP to Use (Kg)"/>
                                                </group>
                                                <group>
                                                    <field name="final_qty" string="Expected Final Output (L)" readonly="1"/>
                                                </group>
                                            </group>

                                            <div class="alert alert-info mt-3" role="alert" invisible="snf_after_water != 0">
                                                <strong>Enter the measured SNF %</strong> from lab test to calculate SMP required.
                                            </div>

                                            <div class="alert alert-warning mt-3" role="alert" invisible="snf_after_water == 0 or is_snf_sufficient">
                                                <strong>Action:</strong>
                                                Add <strong><field name="smp_to_add" readonly="1" nolabel="1"/> Kg</strong> of SMP
                                                to increase SNF from <strong><field name="snf_after_water" readonly="1" nolabel="1"/>%</strong>
                                                to <strong><field name="target_snf" readonly="1" nolabel="1"/>%</strong>.
                                                Then click <strong>"Step 2: Confirm SMP Added"</strong>.
                                            </div>

                                            <div class="alert alert-success mt-3" role="alert" invisible="snf_after_water == 0 or not is_snf_sufficient">
                                                <strong>No SMP needed!</strong>
                                                Current SNF (<field name="snf_after_water" readonly="1" nolabel="1"/>%) already meets target (<field name="target_snf" readonly="1" nolabel="1"/>%).
                                                Click <strong>"Step 2: Confirm SMP Added"</strong> to proceed.
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </page>

                        <!-- STEP2: Final Verification -->
                        <page string="3. Final Verification" name="single_step3"
                              invisible="use_multi_output or state != 'step2'">

                            <!-- Status Banner -->
                            <div class="alert alert-success mb-4" role="alert">
                                <strong>SMP Added!</strong>
                                <field name="smp_consumed" readonly="1" nolabel="1"/> Kg of SMP has been added.
                            </div>

                            <!-- Verification Card -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <div class="card">
                                        <div class="card-header bg-success text-white">
                                            <strong>Step 3: Lab Verification</strong>
                                        </div>
                                        <div class="card-body">
                                            <group>
                                                <group string="Verified Lab Readings">
                                                    <field name="final_fat_verified" string="Final Fat % (Lab Verified)"
                                                           class="fw-bold" placeholder="Enter verified fat %..."/>
                                                    <field name="final_snf_verified" string="Final SNF % (Lab Verified)"
                                                           class="fw-bold" placeholder="Enter verified SNF %..."/>
                                                </group>
                                                <group string="Production Summary">
                                                    <field name="final_qty" string="Final Output Quantity" readonly="1"/>
                                                    <field name="water_consumed" string="Water Used" readonly="1"/>
                                                    <field name="smp_consumed" string="SMP Used" readonly="1"/>
                                                </group>
                                            </group>

                                            <div class="alert alert-info mt-3" role="alert">
                                                <strong>Final Step:</strong>
                                                Enter the lab-verified Fat% and SNF% values, then click <strong>"Step 3: Complete Standardization"</strong>.
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </page>

                        <!-- DONE: Summary -->
                        <page string="Summary" name="single_summary"
                              invisible="use_multi_output or state != 'done'">

                            <div class="alert alert-success mb-4" role="alert">
                                <h4 class="alert-heading mb-0">Standardization Complete!</h4>
                            </div>

                            <div class="row">
                                <div class="col-md-4">
                                    <div class="card mb-3">
                                        <div class="card-header bg-primary text-white">Input</div>
                                        <div class="card-body">
                                            <p><strong>Raw Milk:</strong> <field name="aggregate_qty" readonly="1" nolabel="1"/> L</p>
                                            <p><strong>Fat:</strong> <field name="aggregate_fat" readonly="1" nolabel="1"/>%</p>
                                            <p><strong>SNF:</strong> <field name="aggregate_snf" readonly="1" nolabel="1"/>%</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="card mb-3">
                                        <div class="card-header bg-info text-white">Materials Used</div>
                                        <div class="card-body">
                                            <p><strong>Water:</strong> <field name="water_consumed" readonly="1" nolabel="1"/> L</p>
                                            <p><strong>SMP:</strong> <field name="smp_consumed" readonly="1" nolabel="1"/> Kg</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="card mb-3">
                                        <div class="card-header bg-success text-white">Output</div>
                                        <div class="card-body">
                                            <p><strong>Quantity:</strong> <field name="final_qty" readonly="1" nolabel="1"/> L</p>
                                            <p><strong>Fat:</strong> <field name="final_fat_verified" readonly="1" nolabel="1"/>%</p>
                                            <p><strong>SNF:</strong> <field name="final_snf_verified" readonly="1" nolabel="1"/>%</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </page>

                        <!-- ════════════════════════════════════════════════════════════════════ -->
                        <!-- MULTI-OUTPUT MODE -->
                        <!-- ════════════════════════════════════════════════════════════════════ -->

                        <!-- DRAFT: Step 1 - Fat Standardization (Multi-Output) -->
                        <page string="1. Fat Standardization" name="multi_step1"
                              invisible="not use_multi_output or state != 'draft'">

                            <!-- Input and Status Cards -->
                            <div class="row mb-4">
                                <div class="col-md-4">
                                    <div class="card">
                                        <div class="card-header bg-primary text-white">Raw Milk Input</div>
                                        <div class="card-body">
                                            <group>
                                                <field name="aggregate_qty" string="Quantity (L)"/>
                                                <field name="aggregate_fat" string="Current Fat %"/>
                                                <field name="aggregate_snf" string="Current SNF %"/>
                                            </group>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="card">
                                        <div class="card-header bg-secondary text-white">Allocation Status</div>
                                        <div class="card-body">
                                            <group>
                                                <field name="total_allocated_qty" string="Allocated"/>
                                                <field name="unallocated_qty" string="Unallocated"
                                                       decoration-danger="unallocated_qty > 0.01"
                                                       decoration-success="unallocated_qty &lt;= 0.01"/>
                                            </group>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="card border-info">
                                        <div class="card-header bg-info text-white">Fat Standardization</div>
                                        <div class="card-body text-center">
                                            <p class="mb-1"><strong>Current Fat:</strong> <field name="aggregate_fat" readonly="1" nolabel="1"/>%</p>
                                            <p class="mb-1"><strong>Target Fat:</strong> <field name="target_fat" readonly="1" nolabel="1"/>%</p>
                                            <h4 class="text-primary mt-2">Water: <field name="total_water_calculated" readonly="1" nolabel="1"/> L</h4>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Output Categories -->
                            <div class="card mb-4">
                                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                                    <strong>Output Categories - Allocate Milk &amp; Calculate Water</strong>
                                    <div>
                                        <button name="create_default_lines_from_categories" type="object"
                                                string="Load Categories" class="btn btn-light btn-sm me-2"/>
                                        <button name="action_distribute_equally" type="object"
                                                string="Distribute Equally" class="btn btn-light btn-sm"
                                                invisible="line_count == 0"/>
                                    </div>
                                </div>
                                <div class="card-body p-0">
                                    <field name="standardization_line_ids" nolabel="1">
                                        <list editable="bottom">
                                            <field name="sequence" widget="handle"/>
                                            <field name="output_category_id"/>
                                            <field name="allocated_qty" sum="Total"/>
                                            <field name="allocation_percentage" readonly="1"/>
                                            <field name="target_fat"/>
                                            <field name="target_snf"/>
                                            <field name="water_to_add" sum="Total Water"/>
                                            <field name="water_manual_override" column_invisible="1"/>
                                            <field name="snf_after_water_estimated" readonly="1" string="Est. SNF"/>
                                            <field name="smp_to_add" readonly="1" string="Est. SMP (Kg)" sum="Total Est. SMP"/>
                                            <field name="output_product_id"/>
                                            <field name="use_mrp" string="MRP"/>
                                        </list>
                                    </field>
                                </div>
                            </div>

                            <div class="alert alert-warning" role="alert" invisible="unallocated_qty &lt;= 0.01 or line_count == 0">
                                <strong>Warning:</strong> You have <field name="unallocated_qty" readonly="1" nolabel="1"/> L of unallocated milk. Allocate all milk before proceeding.
                            </div>

                            <div class="alert alert-info" role="alert" invisible="line_count == 0 or unallocated_qty > 0.01">
                                <strong>Action:</strong> Add <strong><field name="total_water_calculated" readonly="1" nolabel="1"/> L</strong> of water to standardize Fat to target. Then click <strong>"Step 1: Confirm Water Added"</strong>.
                            </div>
                        </page>

                        <!-- STEP1: Step 2 - SNF Standardization (Multi-Output) -->
                        <page string="2. SNF Standardization" name="multi_step2"
                              invisible="not use_multi_output or state != 'step1'">

                            <!-- Fat Standardization Complete Banner -->
                            <div class="alert alert-success mb-4" role="alert">
                                <strong>Step 1 Complete: Fat Standardized!</strong>
                                <span class="ms-3">Water Added: <strong><field name="water_consumed" readonly="1" nolabel="1"/> L</strong></span>
                                <span class="ms-3">|</span>
                                <span class="ms-3">Fat reduced to: <strong><field name="target_fat" readonly="1" nolabel="1"/>%</strong></span>
                            </div>

                            <!-- SNF Summary Card -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <div class="card border-warning">
                                        <div class="card-header bg-warning">
                                            <strong>Step 2: SNF STANDARDIZATION (Add SMP)</strong>
                                        </div>
                                        <div class="card-body">
                                            <div class="row text-center mb-3">
                                                <div class="col-md-4">
                                                    <h6 class="text-muted">Total Milk Volume</h6>
                                                    <h4><field name="milk_after_water" readonly="1" nolabel="1"/> L</h4>
                                                </div>
                                                <div class="col-md-4">
                                                    <h6 class="text-muted">Total SMP Required</h6>
                                                    <h4 class="text-primary"><field name="total_smp_calculated" readonly="1" nolabel="1"/> Kg</h4>
                                                </div>
                                                <div class="col-md-4">
                                                    <h6 class="text-muted">Categories</h6>
                                                    <h4><field name="line_count" readonly="1" nolabel="1"/></h4>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Per-Category SNF Entry -->
                            <div class="card mb-4">
                                <div class="card-header bg-warning">
                                    <strong>Enter Measured SNF for Each Category</strong>
                                </div>
                                <div class="card-body p-0">
                                    <field name="standardization_line_ids" nolabel="1">
                                        <list editable="bottom">
                                            <field name="output_category_id" readonly="1"/>
                                            <field name="milk_after_water" readonly="1" string="Milk (L)"/>
                                            <field name="snf_after_water_estimated" readonly="1" string="Est. SNF %"/>
                                            <field name="snf_after_water" string="Measured SNF %"/>
                                            <field name="target_snf" readonly="1"/>
                                            <field name="smp_to_add" readonly="1" string="SMP Calc (Kg)" sum="Total"/>
                                            <field name="smp_consumed" string="SMP to Use (Kg)"/>
                                            <field name="use_mrp" string="MRP" readonly="1"/>
                                            <field name="production_id" string="MO" readonly="1"/>
                                        </list>
                                    </field>
                                </div>
                            </div>

                            <div class="alert alert-info" role="alert">
                                <strong>Action:</strong> Enter measured SNF % for each category, then add <strong><field name="total_smp_calculated" readonly="1" nolabel="1"/> Kg</strong> total SMP. Click <strong>"Step 2: Confirm SMP Added"</strong>.
                            </div>
                        </page>

                        <!-- STEP2: Verification -->
                        <page string="3. Verification" name="multi_step3"
                              invisible="not use_multi_output or state != 'step2'">

                            <div class="alert alert-success mb-4" role="alert">
                                <strong>SMP Added!</strong>
                                Total SMP used: <field name="smp_consumed" readonly="1" nolabel="1"/> Kg
                            </div>

                            <div class="card mb-4">
                                <div class="card-header bg-success text-white">
                                    <strong>Enter Verified Lab Results</strong>
                                </div>
                                <div class="card-body p-0">
                                    <field name="standardization_line_ids" nolabel="1">
                                        <list editable="bottom">
                                            <field name="output_category_id" readonly="1"/>
                                            <field name="output_product_id" readonly="1"/>
                                            <field name="final_qty" readonly="1" sum="Total"/>
                                            <field name="target_fat" readonly="1"/>
                                            <field name="final_fat_verified" string="Verified Fat %"/>
                                            <field name="target_snf" readonly="1"/>
                                            <field name="final_snf_verified" string="Verified SNF %"/>
                                            <field name="use_mrp" string="MRP" readonly="1"/>
                                            <field name="production_id" string="MO" readonly="1"/>
                                            <field name="production_state" string="MO Status" readonly="1"/>
                                        </list>
                                    </field>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="card">
                                        <div class="card-header bg-secondary text-white">Total Output</div>
                                        <div class="card-body">
                                            <p class="fs-4"><strong><field name="total_final_output" readonly="1" nolabel="1"/> Liters</strong></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </page>

                        <!-- DONE: Multi-Output Summary -->
                        <page string="Summary" name="multi_summary"
                              invisible="not use_multi_output or state != 'done'">

                            <div class="alert alert-success mb-4" role="alert">
                                <h4 class="alert-heading mb-0">Multi-Output Standardization Complete!</h4>
                            </div>

                            <div class="row mb-4">
                                <div class="col-md-4">
                                    <div class="card">
                                        <div class="card-header bg-primary text-white">Input</div>
                                        <div class="card-body">
                                            <p><strong>Raw Milk:</strong> <field name="aggregate_qty" readonly="1" nolabel="1"/> L</p>
                                            <p><strong>Fat:</strong> <field name="aggregate_fat" readonly="1" nolabel="1"/>%</p>
                                            <p><strong>SNF:</strong> <field name="aggregate_snf" readonly="1" nolabel="1"/>%</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="card">
                                        <div class="card-header bg-info text-white">Materials</div>
                                        <div class="card-body">
                                            <p><strong>Water:</strong> <field name="water_consumed" readonly="1" nolabel="1"/> L</p>
                                            <p><strong>SMP:</strong> <field name="smp_consumed" readonly="1" nolabel="1"/> Kg</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="card">
                                        <div class="card-header bg-success text-white">Total Output</div>
                                        <div class="card-body">
                                            <p class="fs-4 fw-bold"><field name="total_final_output" readonly="1" nolabel="1"/> Liters</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="card">
                                <div class="card-header bg-secondary text-white">Output Products</div>
                                <div class="card-body p-0">
                                    <field name="standardization_line_ids" nolabel="1" readonly="1">
                                        <list decoration-success="1">
                                            <field name="output_category_id"/>
                                            <field name="output_product_id"/>
                                            <field name="allocated_qty" string="Input (L)"/>
                                            <field name="water_consumed" string="Water (L)"/>
                                            <field name="smp_consumed" string="SMP (Kg)"/>
                                            <field name="final_qty" string="Output (L)" sum="Total"/>
                                            <field name="final_fat_verified" string="Fat %"/>
                                            <field name="final_snf_verified" string="SNF %"/>
                                            <field name="use_mrp" string="MRP"/>
                                            <field name="production_id" string="MO"/>
                                        </list>
                                    </field>
                                </div>
                            </div>
                        </page>

                        <!-- Notes Tab (always visible) -->
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Add any notes about this standardization batch..."/>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── List View ──────────────────────────────────────────── -->
    <record id="view_milk_standardization_list" model="ir.ui.view">
        <field name="name">milk.standardization.list</field>
        <field name="model">milk.standardization</field>
        <field name="arch" type="xml">
            <list string="Milk Standardization Records"
                  decoration-success="state == 'done'"
                  decoration-info="state in ('step1','step2')"
                  decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="date" widget="date"/>
                <field name="aggregate_qty" string="Input (L)" sum="Total Input"/>
                <field name="aggregate_fat" string="Fat %"/>
                <field name="aggregate_snf" string="SNF %"/>
                <field name="water_consumed" string="Water (L)" sum="Total Water"/>
                <field name="smp_consumed" string="SMP (Kg)" sum="Total SMP"/>
                <field name="final_qty" string="Output (L)" sum="Total Output"/>
                <field name="use_multi_output" string="Multi" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('step1','step2')"
                       decoration-warning="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- ── Search View ────────────────────────────────────────────────── -->
    <record id="view_milk_standardization_search" model="ir.ui.view">
        <field name="name">milk.standardization.search</field>
        <field name="model">milk.standardization</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="date"/>
                <field name="product_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state','in',['step1','step2'])]"/>
                <filter string="Completed" name="done" domain="[('state','=','done')]"/>
                <separator/>
                <filter string="Multi-Output" name="multi_output" domain="[('use_multi_output','=',True)]"/>
                <filter string="Single Output" name="single_output" domain="[('use_multi_output','=',False)]"/>
                <separator/>
                <filter string="Today" name="today" domain="[('date','&gt;=', (context_today()).strftime('%Y-%m-%d')),('date','&lt;',(context_today() + relativedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="This Week" name="this_week" domain="[('date','&gt;=', (context_today() - relativedelta(days=context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="By Date" name="group_date" context="{'group_by': 'date:day'}"/>
                <filter string="By Status" name="group_state" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- ── Action ────────────────────────────────────────────────────── -->
    <record id="action_milk_standardization" model="ir.actions.act_window">
        <field name="name">Milk Standardization</field>
        <field name="res_model">milk.standardization</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new milk standardization batch
            </p>
            <p>
                Standardize raw milk by adding water (to reduce fat to 3%)
                and SMP (to increase SNF to 9.5% or your target).
            </p>
        </field>
    </record>

</odoo>
