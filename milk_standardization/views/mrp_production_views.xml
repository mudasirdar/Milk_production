<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Manufacturing Order Form View -->
    <record id="mrp_production_form_inherit_milk_standardization" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.milk.standardization</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <!-- Add standardization link smart button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_standardization"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-flask"
                        invisible="not standardization_id">
                    <field name="standardization_id" widget="statinfo" string="Standardization"/>
                </button>
            </xpath>

            <!-- Add milk standardization fields to the form -->
            <xpath expr="//field[@name='bom_id']" position="after">
                <field name="is_milk_standardization" invisible="1"/>
            </xpath>

            <!-- Add milk standardization specific fields in a group -->
            <xpath expr="//group[@name='group_extra_info']" position="after">
                <group string="Milk Standardization"
                       invisible="not is_milk_standardization"
                       name="group_milk_standardization">
                    <group>
                        <field name="aggregate_fat_percent"/>
                        <field name="water_qty_calculated" readonly="1"/>
                    </group>
                    <group>
                        <field name="snf_after_water_percent"/>
                        <field name="smp_qty_calculated" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Extend Manufacturing Order Tree View -->
    <record id="mrp_production_tree_inherit_milk_standardization" model="ir.ui.view">
        <field name="name">mrp.production.tree.inherit.milk.standardization</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="is_milk_standardization" column_invisible="True"/>
                <field name="standardization_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Search filter for milk standardization MOs -->
    <record id="mrp_production_search_inherit_milk_standardization" model="ir.ui.view">
        <field name="name">mrp.production.search.inherit.milk.standardization</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Milk Standardization"
                        name="milk_standardization"
                        domain="[('is_milk_standardization', '=', True)]"/>
            </xpath>
        </field>
    </record>

</odoo>
