<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_rfaf_po_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 12px; color: #333333;">

                    <!-- Report Header / Title Section -->
                    <div style="border-bottom: 3px solid #2c3e50; padding-bottom: 10px; margin-bottom: 20px;">
                        <table style="width: 100%; border-collapse: collapse;">
                            <tr>
                                <td style="vertical-align: middle; width: 60%;">
                                    <table style="border-collapse: collapse;">
                                        <tr>
                                            <t t-if="company.logo">
                                                <td style="vertical-align: middle; padding-right: 12px;">
                                                    <img t-att-src="image_data_uri(company.logo)" style="max-height: 60px; max-width: 120px;" alt="Company Logo"/>
                                                </td>
                                            </t>
                                            <td style="vertical-align: middle;">
                                                <h2 style="margin: 0; color: #2c3e50; font-weight: bold; text-transform: uppercase;">
                                                    <t t-esc="company.name"/>
                                                </h2>
                                                <p style="margin: 4px 0 0 0; color: #7f8c8d; font-size: 13px;">
                                                    Daily Purchase Order Report
                                                </p>
                                                <p style="margin: 2px 0 0 0; color: #7f8c8d; font-size: 14px;">
                                                    Date: <strong style="color: #2c3e50;" t-esc="report_date.strftime('%d-%b-%Y') if report_date else ''"/>
                                                </p>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                                <td style="vertical-align: top; width: 40%; text-align: right;">
                                    <div style="background-color: #f8f9fa; border: 1px solid #e9ecef; border-radius: 6px; padding: 8px 12px; display: inline-block; text-align: left;">
                                        <div><strong>Total Suppliers:</strong> <span t-esc="len(supplier_matrix)"/></div>
                                        <div><strong>Total Products:</strong> <span t-esc="len(products)"/></div>
                                        <div><strong>Grand Total Qty:</strong> <span t-esc="'%.2f' % grand_total_qty if grand_total_qty % 1 else '%d' % grand_total_qty"/></div>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- Main Purchase Order Matrix Table -->
                    <t t-if="supplier_matrix">
                        <table style="width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 11px;">
                            <thead>
                                <tr style="background-color: #2c3e50; color: #ffffff;">
                                    <th style="width: 40px; text-align: center; padding: 8px 5px; border: 1px solid #2c3e50;">#</th>
                                    <th style="min-width: 160px; text-align: left; padding: 8px 8px; border: 1px solid #2c3e50;">Supplier Name</th>
                                    <t t-foreach="products" t-as="product">
                                        <th style="text-align: center; padding: 8px 5px; border: 1px solid #2c3e50;">
                                            <span t-esc="product.display_name or product.name"/>
                                        </th>
                                    </t>
                                    <th style="width: 80px; text-align: right; padding: 8px 8px; border: 1px solid #2c3e50; background-color: #1a252f;">Total Qty</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="supplier_matrix" t-as="row">
                                    <tr t-att-style="'background-color: %s;' % ('#f8f9fa' if row_index % 2 == 1 else '#ffffff')">
                                        <td style="text-align: center; padding: 7px 5px; border: 1px solid #dee2e6;" t-esc="row['s_no']"/>
                                        <td style="text-align: left; padding: 7px 8px; border: 1px solid #dee2e6;">
                                            <strong style="color: #2c3e50;" t-esc="row['supplier_name']"/>
                                            <t t-if="row['supplier_code']">
                                                <small style="color: #6c757d;"> (<t t-esc="row['supplier_code']"/>)</small>
                                            </t>
                                        </td>
                                        <t t-foreach="products" t-as="product">
                                            <td style="text-align: center; padding: 7px 5px; border: 1px solid #dee2e6;">
                                                <t t-set="pqty" t-value="row['product_qty'].get(product.id, 0.0)"/>
                                                <t t-if="pqty &gt; 0">
                                                    <span style="font-weight: bold; color: #16a085;" t-esc="'%.2f' % pqty if pqty % 1 else '%d' % pqty"/>
                                                </t>
                                                <t t-else="">
                                                    <span style="color: #bdc3c7;">-</span>
                                                </t>
                                            </td>
                                        </t>
                                        <td style="text-align: right; padding: 7px 8px; border: 1px solid #dee2e6; background-color: #f1f2f6; font-weight: bold; color: #2c3e50;">
                                            <span t-esc="'%.2f' % row['total_qty'] if row['total_qty'] % 1 else '%d' % row['total_qty']"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="background-color: #e2e8f0; font-weight: bold; border-top: 2px solid #2c3e50;">
                                    <td colspan="2" style="text-align: right; padding: 9px 8px; border: 1px solid #cbd5e1; font-size: 12px; color: #1e293b;">
                                        TOTAL:
                                    </td>
                                    <t t-foreach="products" t-as="product">
                                        <td style="text-align: center; padding: 9px 5px; border: 1px solid #cbd5e1; font-size: 12px; color: #0f766e;">
                                            <t t-set="ptotal" t-value="product_totals.get(product.id, 0.0)"/>
                                            <span t-esc="'%.2f' % ptotal if ptotal % 1 else '%d' % ptotal"/>
                                        </td>
                                    </t>
                                    <td style="text-align: right; padding: 9px 8px; border: 1px solid #cbd5e1; background-color: #cbd5e1; font-size: 13px; color: #0f172a;">
                                        <span t-esc="'%.2f' % grand_total_qty if grand_total_qty % 1 else '%d' % grand_total_qty"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </t>

                    <t t-else="">
                        <div style="margin-top: 30px; padding: 20px; text-align: center; background-color: #fff3cd; border: 1px solid #ffe69c; border-radius: 6px; color: #856404;">
                            <h4>No Purchase Orders Found</h4>
                            <p style="margin-bottom: 0;">There are no confirmed purchase orders for <span t-esc="report_date.strftime('%d-%b-%Y') if report_date else ''"/>.</p>
                        </div>
                    </t>

                    <!-- Footer / Signature Block -->
                    <div style="margin-top: 40px; page-break-inside: avoid;">
                        <table style="width: 100%; border-collapse: collapse;">
                            <tr>
                                <td style="width: 50%; text-align: left; vertical-align: bottom;">
                                    <p style="color: #7f8c8d; font-size: 10px; margin: 0;">
                                        Generated by Odoo Purchase Order System
                                    </p>
                                </td>
                                <td style="width: 50%; text-align: right; vertical-align: bottom;">
                                    <div style="display: inline-block; text-align: center; width: 200px;">
                                        <div style="border-bottom: 1px solid #2c3e50; height: 40px;"></div>
                                        <p style="margin-top: 5px; font-weight: bold; color: #2c3e50; font-size: 11px;">Authorized Signature</p>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>

                </div>
            </t>
        </t>
    </template>
</odoo>
