<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Sequence ──────────────────────────────────────────────────────── -->
    <record id="seq_rfaf_return_leakage" model="ir.sequence">
        <field name="name">Return &amp; Leakage</field>
        <field name="code">rfaf.return.leakage</field>
        <field name="prefix">RL/</field>
        <field name="padding">5</field>
    </record>

    <!-- ── Tree View (Invoice-wise) ──────────────────────────────────────── -->
    <record id="rfaf_return_leakage_tree" model="ir.ui.view">
        <field name="name">rfaf.return.leakage.list</field>
        <field name="model">rfaf.return.leakage</field>
        <field name="arch" type="xml">
            <list string="Return &amp; Leakage">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="invoice_id"/>
                <field name="sale_order_id"/>
                <field name="total_return_amount" sum="Total Return"/>
                <field name="total_leakage_amount" sum="Total Leakage"/>
                <field name="total_deduction" sum="Total Deduction"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- ── Form View (with product lines) ────────────────────────────────── -->
    <record id="rfaf_return_leakage_form" model="ir.ui.view">
        <field name="name">rfaf.return.leakage.form</field>
        <field name="model">rfaf.return.leakage</field>
        <field name="arch" type="xml">
            <form string="Return &amp; Leakage">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Source">
                            <field name="invoice_id"/>
                            <field name="sale_order_id"/>
                            <field name="partner_id"/>
                            <field name="date"/>
                        </group>
                        <group string="Totals">
                            <field name="total_return_amount"/>
                            <field name="total_leakage_amount"/>
                            <field name="total_deduction"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Product Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="dispatched_qty"/>
                                    <field name="return_qty"/>
                                    <field name="leakage_qty"/>
                                    <field name="price_unit"/>
                                    <field name="return_amount"/>
                                    <field name="leakage_amount"/>
                                    <field name="total_deduction"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Search View ───────────────────────────────────────────────────── -->
    <record id="rfaf_return_leakage_search" model="ir.ui.view">
        <field name="name">rfaf.return.leakage.search</field>
        <field name="model">rfaf.return.leakage</field>
        <field name="arch" type="xml">
            <search string="Return &amp; Leakage">
                <field name="partner_id" string="Customer"/>
                <field name="invoice_id"/>
                <field name="sale_order_id"/>
                <separator/>
                <filter name="filter_today" string="Today"
                        domain="[('date', '&gt;=', 'today'), ('date', '&lt;', 'today +1d')]"/>
                <filter name="filter_yesterday" string="Yesterday"
                        domain="[('date', '&gt;=', 'today -1d'), ('date', '&lt;', 'today')]"/>
                <filter name="filter_this_week" string="This Week"
                        domain="[('date', '&gt;=', '=week_start'), ('date', '&lt;', '=week_start +1w')]"/>
                <filter name="filter_this_month" string="This Month"
                        domain="[('date', '&gt;=', '=1d'), ('date', '&lt;', '=1d +1m')]"/>
                <filter name="filter_last_month" string="Last Month"
                        domain="[('date', '&gt;=', '=1d -1m'), ('date', '&lt;', '=1d')]"/>
                <separator/>
                <group>
                    <filter name="group_customer" string="Customer"
                            domain="[]" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_date" string="Date"
                            domain="[]" context="{'group_by': 'date:day'}"/>
                    <filter name="group_month" string="Month"
                            domain="[]" context="{'group_by': 'date:month'}"/>
                    <filter name="group_invoice" string="Invoice"
                            domain="[]" context="{'group_by': 'invoice_id'}"/>
                    <filter name="group_sale_order" string="Sale Order"
                            domain="[]" context="{'group_by': 'sale_order_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Action ────────────────────────────────────────────────────────── -->
    <record id="action_rfaf_return_leakage" model="ir.actions.act_window">
        <field name="name">Return &amp; Leakage</field>
        <field name="res_model">rfaf.return.leakage</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="rfaf_return_leakage_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No return or leakage records yet.
            </p>
            <p>
                Records are created automatically when return or leakage
                quantities are entered on invoice lines.
            </p>
        </field>
    </record>

    <!-- ── Menu ──────────────────────────────────────────────────────────── -->
    <menuitem id="menu_rfaf_return_leakage_root"
              name="Return &amp; Leakage"
              parent="account.menu_finance"
              sequence="40"/>

    <menuitem id="menu_rfaf_return_leakage"
              name="Return &amp; Leakage Records"
              parent="menu_rfaf_return_leakage_root"
              action="action_rfaf_return_leakage"
              sequence="10"/>

</odoo>
